__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
.eggs/
*.log
*.tmp

# Ignore virtual environments
venv/
.venv/
env/
ENV/

# Ignore environment files
*.env
.env.*
.envrc

# Byte-compiled / optimized / DLL files
*.pyc
*.pyd
*.pyo
*.pdb

# =====================================
# FastAPI Backend
# =====================================

# SQLite Databases
*.db
*.sqlite3

# Compiled files
*.migrations/
*.sqlite

# Uvicorn logging
uvicorn.log

# =====================================
# Streamlit Frontend
# =====================================

# Streamlit caches & temp
.streamlit/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ipynb_checkpoints/

# Upload temp files
temp_upload_*
uploaded_files/
temp/*

# =====================================
# Node / JS (if used later)
# =====================================
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# =====================================
# VS Code / PyCharm / Editors
# =====================================
.vscode/
.idea/
*.iml

# =====================================
# OS-generated files
# =====================================
.DS_Store
Thumbs.db
desktop.ini

# =====================================
# Build & Distribution Files
# =====================================
dist/
build/
*.egg-info/
*.spec

# =====================================
# Images / Zip / Large files (optional)
# =====================================
*.zip
*.rar
*.7z

# =====================================
# Project-Specific
# =====================================

# Data folder that includes runtime DBs
backend/data/*.db
backend/data/temp_*

# Cache files inside backend/frontend
backend/__pycache__/
frontend/__pycache__/

